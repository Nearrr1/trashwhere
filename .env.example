# ==============================================================================
# TrashWhere — Environment Variables Configuration
# Copy this file to .env.local for local development.
# Never commit real API keys, secrets, or service credentials to the repository.
# ==============================================================================

# --- AI Provider Configuration (Required) ---
# Primary Google Gemini API Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini model identifier (Optional, default: gemini-3.5-flash)
# Fallbacks: gemini-3.5-flash-lite, gemini-3.7-flash, gemini-2.5-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash

# Optional fallback OpenAI API Key (if used instead of Gemini)
OPENAI_API_KEY=

# --- Rate Limiting & Protection Configuration (Optional) ---
# Maximum requests allowed per window per IP (default: 15)
RATE_LIMIT_MAX_REQUESTS=15

# Sliding rate limit window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# --- Authentication Configuration (NextAuth v5 / Google OAuth) ---
# Secret encryption key for session cookies (minimum 32 characters)
AUTH_SECRET=your_nextauth_auth_secret_minimum_32_characters_here

# Google Cloud OAuth Credentials (Optional: required for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- Cloud Database Configuration (MongoDB Atlas) ---
# MongoDB Atlas Connection URI (Optional: required for Cloud Scan History)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=trashwhere

